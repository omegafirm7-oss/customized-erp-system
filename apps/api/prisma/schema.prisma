  userAgent       String?

  @@index([companyId, entityName, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Finance: AR/AP invoices & payments
// ─────────────────────────────────────────────────────────────────────────

model SalesInvoice {
  id                       String            @id @default(uuid())
  companyId                String
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Null while Draft — allocated gaplessly at posting time, same pattern as
  // JournalEntry.entryNumber. ZATCA Phase 2 requires a gapless sequence here.
  invoiceNumber            String?
  documentKind             SalesDocumentKind @default(INVOICE)
  businessPartnerId        String
  businessPartner          BusinessPartner   @relation(fields: [businessPartnerId], references: [id])
  // Required (service-enforced) when documentKind = CREDIT_NOTE; becomes the
  // ZATCA billing reference in the e-invoicing phase.
  originalInvoiceId        String?
  originalInvoice          SalesInvoice?     @relation("CreditNoteOriginal", fields: [originalInvoiceId], references: [id])
  creditNotes              SalesInvoice[]    @relation("CreditNoteOriginal")
  status                   InvoiceStatus     @default(DRAFT)
  issueDateTime            DateTime
  postingDate              DateTime
  dueDate                  DateTime
  currencyCode             String
  exchangeRateToFunctional Decimal           @default(1) @db.Decimal(18, 8)
  // ZATCA-ready snapshots, captured at posting time so later partner edits
  // never change what was legally invoiced.
  buyerNameSnapshot        String?
  buyerTrnSnapshot         String?
  invoiceTypeCode          String?
  // ZATCA UBL fields: ActualDeliveryDate (mandatory for standard invoices,
  // defaults to postingDate at post), PaymentMeans code (UNTDID 4461),
  // and the mandatory reason for credit notes (KSA-10 InstructionNote).
  deliveryDate             DateTime?
  paymentMeansCode         String?
  creditNoteReason         String?
  netTotal                 Decimal           @default(0) @db.Decimal(18, 4)
  vatTotal                 Decimal           @default(0) @db.Decimal(18, 4)
  grossTotal               Decimal           @default(0) @db.Decimal(18, 4)
  netTotalFunctional       Decimal           @default(0) @db.Decimal(18, 4)
  vatTotalFunctional       Decimal           @default(0) @db.Decimal(18, 4)
  grossTotalFunctional     Decimal           @default(0) @db.Decimal(18, 4)
  paidAmount               Decimal           @default(0) @db.Decimal(18, 4)
  openAmount               Decimal           @default(0) @db.Decimal(18, 4)
  journalEntryId           String?           @unique
  journalEntry             JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  timesheet                Timesheet?
  usageLog                 UsageLog?
  memo                     String?
  createdByUserId          String
  postedByUserId           String?
  postedAt                 DateTime?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  lines              SalesInvoiceLine[]
  paymentAllocations PaymentAllocation[]
  zatcaSubmission    ZatcaSubmission?

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, businessPartnerId])
  @@index([companyId, dueDate])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id                     String         @id @default(uuid())
  salesInvoiceId         String
  salesInvoice           SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  companyId              String
  lineNumber             Int
  itemId                 String?
  item                   Item?          @relation(fields: [itemId], references: [id])
  description            String
  uomId                  String?
  uom                    UnitOfMeasure? @relation(fields: [uomId], references: [id])
  quantity               Decimal        @db.Decimal(18, 6)
  unitPrice              Decimal        @db.Decimal(18, 4)
  discountAmount         Decimal        @default(0) @db.Decimal(18, 4)
  netAmount              Decimal        @db.Decimal(18, 4)
  vatCategory            VatCategory
  // Snapshot of the rate applied — historical documents must not change if
  // VAT_RATES changes in a future fiscal reform.
  vatRate                Decimal        @db.Decimal(5, 2)
  vatAmount              Decimal        @db.Decimal(18, 4)
  grossAmount            Decimal        @db.Decimal(18, 4)
  // ZATCA: mandatory for ZERO_RATED/EXEMPT lines (VATEX-SA-* catalog)
  vatExemptionReasonCode String?
  vatExemptionReasonText String?
  // Required (service-enforced) for inventory items; resolved at draft time.
  warehouseId            String?
  warehouse              Warehouse?     @relation(fields: [warehouseId], references: [id])
  // Job-costing dimensions (Phase 5): stamped onto the GL revenue/COGS legs.
  projectId              String?
  project                Project?       @relation(fields: [projectId], references: [id])
  wbsTaskId              String?
  wbsTask                WbsTask?       @relation(fields: [wbsTaskId], references: [id])
  // Explicit cost-center dimension (Phase 7) — takes precedence over the
  // project's cost center on the GL revenue leg. Mutually exclusive with
  // projectId (service-enforced).
  costCenterId           String?
  costCenter             CostCenter?    @relation(fields: [costCenterId], references: [id])
  revenueAccountId       String
  revenueAccount         Account        @relation(fields: [revenueAccountId], references: [id])

  @@index([salesInvoiceId])
  @@index([companyId, itemId])
  @@map("sales_invoice_lines")
}

model PurchaseInvoice {
  id                       String          @id @default(uuid())
  companyId                String
  company                  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNumber            String?
  // The supplier's own invoice number — unique per vendor to block booking
  // the same supplier bill twice.
  vendorInvoiceNumber      String
  businessPartnerId        String
  businessPartner          BusinessPartner @relation(fields: [businessPartnerId], references: [id])
  // Set when this invoice was generated from a Purchase Order (see
  // PurchaseOrder.generateInvoice); null for a directly-created invoice
  // (the pre-existing, non-PO purchasing path — unchanged).
  sourcePurchaseOrderId    String?
  sourcePurchaseOrder      PurchaseOrder?  @relation(fields: [sourcePurchaseOrderId], references: [id])
  status                   InvoiceStatus   @default(DRAFT)
  postingDate              DateTime
  dueDate                  DateTime
  currencyCode             String
  exchangeRateToFunctional Decimal         @default(1) @db.Decimal(18, 8)
  netTotal                 Decimal         @default(0) @db.Decimal(18, 4)
  vatTotal                 Decimal         @default(0) @db.Decimal(18, 4)
  grossTotal               Decimal         @default(0) @db.Decimal(18, 4)
  netTotalFunctional       Decimal         @default(0) @db.Decimal(18, 4)
  vatTotalFunctional       Decimal         @default(0) @db.Decimal(18, 4)
  grossTotalFunctional     Decimal         @default(0) @db.Decimal(18, 4)
  paidAmount               Decimal         @default(0) @db.Decimal(18, 4)
  openAmount               Decimal         @default(0) @db.Decimal(18, 4)
  journalEntryId           String?         @unique
  journalEntry             JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  memo                     String?
  createdByUserId          String
  postedByUserId           String?
  postedAt                 DateTime?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  lines              PurchaseInvoiceLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, businessPartnerId, vendorInvoiceNumber])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([sourcePurchaseOrderId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  companyId         String
  lineNumber        Int
  itemId            String?
  item              Item?           @relation(fields: [itemId], references: [id])
  description       String
  uomId             String?
  uom               UnitOfMeasure?  @relation(fields: [uomId], references: [id])
  quantity          Decimal         @db.Decimal(18, 6)
  unitPrice         Decimal         @db.Decimal(18, 4)
  discountAmount    Decimal         @default(0) @db.Decimal(18, 4)
  netAmount         Decimal         @db.Decimal(18, 4)
  vatCategory       VatCategory
  vatRate           Decimal         @db.Decimal(5, 2)
  vatAmount         Decimal         @db.Decimal(18, 4)
  grossAmount       Decimal         @db.Decimal(18, 4)
  // Required (service-enforced) for inventory items; resolved at draft time.
  warehouseId       String?
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  // Job-costing dimensions (Phase 5): stamped onto the GL expense legs.
  projectId         String?
  project           Project?        @relation(fields: [projectId], references: [id])
  wbsTaskId         String?
  wbsTask           WbsTask?        @relation(fields: [wbsTaskId], references: [id])
  // Explicit cost-center dimension (Phase 8 — e.g. equipment maintenance);
  // takes precedence over the project's cost center on the GL expense leg.
  costCenterId      String?
  costCenter        CostCenter?     @relation(fields: [costCenterId], references: [id])
  // For inventory items this holds the INVENTORY asset account, not an
  // expense — resolved at draft time by LineBuilderService.
  expenseAccountId  String
  expenseAccount    Account         @relation(fields: [expenseAccountId], references: [id])

  attachment PurchaseInvoiceLineAttachment?

  @@index([purchaseInvoiceId])
  @@index([companyId, itemId])
  @@map("purchase_invoice_lines")
}

// A single evidence file (receipt/bill scan) attached to a recorded expense
// line — same storage pattern as EmployeePaymentAttachment (bytes in
// Postgres, upsert-on-reupload, no separate file-storage infra).
model PurchaseInvoiceLineAttachment {
  id                    String              @id @default(uuid())
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoiceLineId String              @unique
  purchaseInvoiceLine   PurchaseInvoiceLine @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: Cascade)
  filename              String
  mimeType              String
  size                  Int
  data                  Bytes
  uploadedByUserId      String
  createdAt             DateTime            @default(now())

  @@map("purchase_invoice_line_attachments")
}

// ─────────────────────────────────────────────────────────────────────────
// Purchasing cycle: Quotation → Order → Invoice (PurchaseInvoice, above).
// Neither Quotation nor Order posts to the GL — a quotation is a vendor's
// quoted price (no commitment), an order is a commitment but not yet a
// transaction (matches the standard "PO doesn't hit the books" convention
// and this system's established draft-doesn't-post pattern). Only the
// resulting PurchaseInvoice posts, exactly as it already did before this
// cycle existed.
// ─────────────────────────────────────────────────────────────────────────

enum PurchaseQuotationStatus {
  DRAFT
  RECEIVED
  CONVERTED
  CANCELLED
}

model PurchaseQuotation {
  id                String                  @id @default(uuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Null while Draft — allocated at RECEIVED, mirroring how invoice numbers
  // are allocated only once a document becomes real (see PurchaseInvoice).
  quotationNumber   String?
  businessPartnerId String
  businessPartner   BusinessPartner         @relation(fields: [businessPartnerId], references: [id])
  quotationDate     DateTime
  validUntil        DateTime?
  status            PurchaseQuotationStatus @default(DRAFT)
  memo              String?
  createdByUserId   String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  lines          PurchaseQuotationLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, quotationNumber])
  @@index([companyId, status])
  @@map("purchase_quotations")
}

model PurchaseQuotationLine {
  id                  String            @id @default(uuid())
  purchaseQuotationId String
  purchaseQuotation   PurchaseQuotation @relation(fields: [purchaseQuotationId], references: [id], onDelete: Cascade)
  lineNumber          Int
  itemId              String?
  item                Item?             @relation(fields: [itemId], references: [id])
  description         String
  quantity            Decimal           @db.Decimal(18, 6)
  unitPrice           Decimal           @db.Decimal(18, 4)
  vatCategory         VatCategory?

  @@index([purchaseQuotationId])
  @@map("purchase_quotation_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_INVOICED
  INVOICED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderNumber       String?
  businessPartnerId String
  businessPartner   BusinessPartner     @relation(fields: [businessPartnerId], references: [id])
  // Optional — a PO can be raised directly, without a prior quotation.
  sourceQuotationId String?
  sourceQuotation   PurchaseQuotation?  @relation(fields: [sourceQuotationId], references: [id])
  orderDate         DateTime
  expectedDate      DateTime?
  status            PurchaseOrderStatus @default(DRAFT)
  memo              String?
  createdByUserId   String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  lines            PurchaseOrderLine[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([sourceQuotationId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNumber       Int
  itemId           String?
  item             Item?         @relation(fields: [itemId], references: [id])
  description      String
  quantity         Decimal       @db.Decimal(18, 6)
  // How much of `quantity` has already been carried onto a generated
  // PurchaseInvoice — drives PARTIALLY_INVOICED vs INVOICED and how much
  // remains to prefill on the next invoice.
  invoicedQuantity Decimal       @default(0) @db.Decimal(18, 6)
  unitPrice        Decimal       @db.Decimal(18, 4)
  vatCategory      VatCategory?
  // Carried onto the generated PurchaseInvoiceLine at invoice time.
  warehouseId      String?
  warehouse        Warehouse?    @relation(fields: [warehouseId], references: [id])
  costCenterId     String?
  costCenter       CostCenter?   @relation(fields: [costCenterId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model Payment {
  id                       String           @id @default(uuid())
  companyId                String
  company                  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentNumber            String?
  direction                PaymentDirection
  businessPartnerId        String
  businessPartner          BusinessPartner  @relation(fields: [businessPartnerId], references: [id])
  paymentDate              DateTime
  bankCashAccountId        String
  bankCashAccount          Account          @relation(fields: [bankCashAccountId], references: [id])
  currencyCode             String
  exchangeRateToFunctional Decimal          @default(1) @db.Decimal(18, 8)
  amount                   Decimal          @db.Decimal(18, 4)
  allocatedAmount          Decimal          @default(0) @db.Decimal(18, 4)
  unallocatedAmount        Decimal          @default(0) @db.Decimal(18, 4)
  reference                String?
  memo                     String?
  status                   PaymentStatus    @default(POSTED)
  journalEntryId           String?          @unique
  journalEntry             JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  createdByUserId          String
  cancelledByUserId        String?
  cancelledAt              DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  allocations PaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId, direction, status])
  @@index([companyId, businessPartnerId])
  @@map("payments")
}

model PaymentAllocation {
  id                String           @id @default(uuid())
  paymentId         String
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  companyId         String
  // Exactly one of the two is set (DB CHECK in finance-constraints migration).
  salesInvoiceId    String?
  salesInvoice      SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  allocatedAmount   Decimal          @db.Decimal(18, 4)
  createdAt         DateTime         @default(now())

  @@index([paymentId])
  @@index([salesInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("payment_allocations")
}

// ─────────────────────────────────────────────────────────────────────────
// ZATCA e-Invoicing (Fatoora)
// ─────────────────────────────────────────────────────────────────────────

// One EGS (e-invoice generation solution) unit per company per environment.
// Holds the signing identity and the per-device compliance chain state:
// icvCounter (KSA-16 invoice counter) and lastInvoiceHash (KSA-13 PIH).
// Both are mutated only under SELECT ... FOR UPDATE inside the invoice-post
// transaction — the same row-lock discipline as NumberingSeries.
model ZatcaDevice {
  id                   String            @id @default(uuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  environment          ZatcaEnvironment
  unitName             String
  egsSerialNumber      String
  // Private key + CSID secrets are AES-256-GCM encrypted at rest with
  // ZATCA_KEY_ENCRYPTION_KEY from env; never exposed through the API.
  privateKeyEnc        String
  csrPem               String
  complianceRequestId  String?
  complianceCsid       String?
  complianceSecretEnc  String?
  productionCsid       String?
  productionSecretEnc  String?
  certificateExpiresAt DateTime?
  status               ZatcaDeviceStatus @default(CREATED)
  failureReason        String?
  // PIH chain seed: base64 of the hex string of sha256("0"), per ZATCA spec.
  icvCounter           Int               @default(0)
  lastInvoiceHash      String            @default("NWZlY2ViNjZmZmM4NmYzOGQ5NTI3ODZjNmQ2OTZjNzljMmRiYzIzOWRkNGU5MWI0NjcyOWQ3M2EyN2ZiNTdlOQ==")
  onboardedAt          DateTime?
  createdByUserId      String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  submissions ZatcaSubmission[]

  @@unique([companyId, environment])
  @@map("zatca_devices")
}

model ZatcaSubmission {
  id                  String                @id @default(uuid())
  companyId           String
  deviceId            String
  device              ZatcaDevice           @relation(fields: [deviceId], references: [id])
  salesInvoiceId      String                @unique
  salesInvoice        SalesInvoice          @relation(fields: [salesInvoiceId], references: [id])
  uuid                String
  icv                 Int
  invoiceHash         String
  previousInvoiceHash String
  invoiceKind         ZatcaInvoiceKind
  submissionType      ZatcaSubmissionType
  // Signed UBL XML as generated by us. For STANDARD invoices, clearedXml is
  // the ZATCA-countersigned document — the legal artifact to share with the
  // buyer; signedXml must not be distributed for standard invoices.
  signedXml           String
  clearedXml          String?
  // TLV base64: set at generation for SIMPLIFIED, extracted from clearedXml
  // for STANDARD after clearance.
  qrCode              String?
  status              ZatcaSubmissionStatus @default(PENDING)
  zatcaResponse       Json?
  warnings            Json?
  errors              Json?
  retryCount          Int                   @default(0)
  lastAttemptAt       DateTime?
  submittedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([deviceId, icv])
  @@index([companyId, status])
  @@map("zatca_submissions")
}

// ─────────────────────────────────────────────────────────────────────────
// Trading & Inventory (Phase 4)
// ─────────────────────────────────────────────────────────────────────────

// Perpetual-inventory state: one row per item per warehouse.
// totalValue (functional currency) is the authoritative figure that must
// reconcile to the INVENTORY GL account; avgCost is a cached derivation
// (totalValue / onHandQty). Rows are mutated ONLY under SELECT ... FOR
// UPDATE inside the posting transaction — the NumberingService discipline.
model ItemWarehouseStock {
  id          String    @id @default(uuid())
  companyId   String
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  onHandQty   Decimal   @default(0) @db.Decimal(18, 6)
  totalValue  Decimal   @default(0) @db.Decimal(18, 4)
  avgCost     Decimal   @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, warehouseId])
  @@index([companyId])
  @@map("item_warehouse_stock")
}

// Append-only movement ledger (IAS 2 audit trail). qtyAfter/avgCostAfter
// are running-balance snapshots so the ledger report needs no window
// functions. journalEntryId is set-once after JE creation in the same tx
// (enforced by trigger); null for transfers, which post no JE.
model StockMovement {
  id                 String            @id @default(uuid())
  companyId          String
  itemId             String
  item               Item              @relation(fields: [itemId], references: [id])
  warehouseId        String
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id])
  movementType       StockMovementType
  quantity           Decimal           @db.Decimal(18, 6)
  unitCost           Decimal           @db.Decimal(18, 6)
  totalCost          Decimal           @db.Decimal(18, 4)
  qtyAfter           Decimal           @db.Decimal(18, 6)
  avgCostAfter       Decimal           @db.Decimal(18, 6)
  sourceDocumentType DocumentType
  sourceDocumentId   String
  journalEntryId     String?
  journalEntry       JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  postingDate        DateTime
  memo               String?
  createdByUserId    String
  createdAt          DateTime          @default(now())

  @@index([companyId, itemId, warehouseId, createdAt])
  @@index([companyId, sourceDocumentId])
  @@map("stock_movements")
}

// Immediate-post document (no draft/status/cancel — corrections are made
// with an opposite transfer). No JE: value never leaves the INVENTORY GL
// account; the document + TRANSFER_OUT/IN movement pair is the audit trail.
model StockTransfer {
  id              String    @id @default(uuid())
  companyId       String
  transferNumber  String
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  postingDate     DateTime
  memo            String?
  createdByUserId String
  createdAt       DateTime  @default(now())

  lines StockTransferLine[]

  @@unique([companyId, transferNumber])
  @@map("stock_transfers")
}

model StockTransferLine {
  id              String        @id @default(uuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  companyId       String
  lineNumber      Int
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Decimal       @db.Decimal(18, 6)
  unitCost        Decimal       @db.Decimal(18, 6)
  totalCost       Decimal       @db.Decimal(18, 4)

  @@index([stockTransferId])
  @@map("stock_transfer_lines")
}

// Immediate-post; one direction per document. IN receives at the client's
// unitCost (JE Dr Inventory / Cr 5150); OUT issues at moving average
// (JE Dr 5150 / Cr Inventory).
model StockAdjustment {
  id               String                   @id @default(uuid())
  companyId        String
  adjustmentNumber String
  warehouseId      String
  warehouse        Warehouse                @relation(fields: [warehouseId], references: [id])
  direction        StockAdjustmentDirection
  postingDate      DateTime
  reason           String
  journalEntryId   String?                  @unique
  journalEntry     JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  createdByUserId  String
  createdAt        DateTime                 @default(now())

  lines StockAdjustmentLine[]

  @@unique([companyId, adjustmentNumber])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                String          @id @default(uuid())
  stockAdjustmentId String
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  companyId         String
  lineNumber        Int
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Decimal         @db.Decimal(18, 6)
  unitCost          Decimal         @db.Decimal(18, 6)
  totalCost         Decimal         @db.Decimal(18, 4)

  @@index([stockAdjustmentId])
  @@map("stock_adjustment_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Projects — full job accounting (Phase 5)
// ─────────────────────────────────────────────────────────────────────────

// A project is 1:1 with an auto-created cost center (code "PRJ-<code>").
// All financial values are functional currency. estimatedTotalCost is the
// cost-to-cost POC basis; both it and contractValue are PATCHable while
// ACTIVE (audit-logged) and snapshotted onto each revenue-recognition run.
model Project {
  id                 String            @id @default(uuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  businessPartnerId  String?
  businessPartner    BusinessPartner?  @relation(fields: [businessPartnerId], references: [id])
  status             ProjectStatus     @default(PLANNED)
  recognitionMethod  RecognitionMethod @default(POINT_IN_TIME)
  startDate          DateTime?
  endDate            DateTime?
  contractValue      Decimal           @default(0) @db.Decimal(18, 4)
  estimatedTotalCost Decimal           @default(0) @db.Decimal(18, 4)
  costCenterId       String            @unique
  costCenter         CostCenter        @relation(fields: [costCenterId], references: [id])
  createdByUserId    String
  updatedByUserId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tasks                  WbsTask[]
  revenueRecognitionRuns RevenueRecognitionRun[]
  salesInvoiceLines      SalesInvoiceLine[]
  purchaseInvoiceLines   PurchaseInvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("projects")
}

// WBS task tree (arbitrary depth). Budget rollup is informational —
// variance is reported, postings are never rejected on budget grounds.
model WbsTask {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId    String
  parentTaskId String?
  parentTask   WbsTask?  @relation("WbsHierarchy", fields: [parentTaskId], references: [id])
  children     WbsTask[] @relation("WbsHierarchy")
  code         String
  name         String
  costBudget   Decimal   @default(0) @db.Decimal(18, 4)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  journalEntryLines    JournalEntryLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@unique([projectId, code])
  @@index([projectId])
  @@map("wbs_tasks")
}

// One POC revenue-recognition run per project per fiscal period (enforced
// by a partial unique index WHERE status='POSTED' — reverse-then-rerun for
// corrections). Snapshots make every run independently auditable.
model RevenueRecognitionRun {
  id                         String                      @id @default(uuid())
  companyId                  String
  projectId                  String
  project                    Project                     @relation(fields: [projectId], references: [id])
  fiscalPeriodId             String
  fiscalPeriod               FiscalPeriod                @relation(fields: [fiscalPeriodId], references: [id])
  runDate                    DateTime
  costsToDateFunctional      Decimal                     @db.Decimal(18, 4)
  estimatedTotalCostSnapshot Decimal                     @db.Decimal(18, 4)
  contractValueSnapshot      Decimal                     @db.Decimal(18, 4)
  percentComplete            Decimal                     @db.Decimal(7, 4)
  cumulativeRevenue          Decimal                     @db.Decimal(18, 4)
  previouslyRecognized       Decimal                     @db.Decimal(18, 4)
  recognizedThisRun          Decimal                     @db.Decimal(18, 4)
  journalEntryId             String                      @unique
  journalEntry               JournalEntry                @relation("RevRecJournal", fields: [journalEntryId], references: [id])
  status                     RevenueRecognitionRunStatus @default(POSTED)
  reversalJournalEntryId     String?                     @unique
  reversalJournalEntry       JournalEntry?               @relation("RevRecReversalJournal", fields: [reversalJournalEntryId], references: [id])
  createdByUserId            String
  createdAt                  DateTime                    @default(now())

  @@index([projectId, fiscalPeriodId])
  @@map("revenue_recognition_runs")
}

// ─────────────────────────────────────────────────────────────────────────
// HR & Saudi Payroll
// ─────────────────────────────────────────────────────────────────────────

// Per-company statutory configuration. Rates are configurable because GOSI
// reform changes contribution rates over time — never hardcode them.
model HrSettings {
  id                     String    @id @default(uuid())
  companyId              String    @unique
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saudiEmployeeRatePct   Decimal   @default(9.75) @db.Decimal(7, 4)
  saudiEmployerRatePct   Decimal   @default(11.75) @db.Decimal(7, 4)
  expatEmployerRatePct   Decimal   @default(2) @db.Decimal(7, 4)
  gosiWageFloor          Decimal   @default(1500) @db.Decimal(18, 4)
  gosiWageCap            Decimal   @default(45000) @db.Decimal(18, 4)
  overtimeMultiplier     Decimal   @default(1.5) @db.Decimal(7, 4)
  hoursPerDay            Decimal   @default(8) @db.Decimal(7, 2)
  daysPerMonth           Decimal   @default(30) @db.Decimal(7, 2)
  defaultAnnualLeaveDays Decimal   @default(21) @db.Decimal(7, 2)
  eosbBasis              EosbBasis @default(FULL_GROSS)
  // WPS SIF employer identifiers
  molEstablishmentId     String?
  employerBankCode       String?
  employerIban           String?
  updatedByUserId        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("hr_settings")
}

model Employee {
  id                  String         @id @default(uuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                String
  nameEn              String
  nameAr              String?
  // Job title / trade, e.g. "Mason", "Electrician", "Site Supervisor" —
  // matches the profession printed on the Saudi iqama/work permit.
  designation         String?
  nationality         String?
  isSaudi             Boolean        @default(false)
  gender              String?
  dateOfBirth         DateTime?
  iqamaOrNationalId   String?
  iqamaExpiry         DateTime?
  passportNumber      String?
  passportExpiry      DateTime?
  gosiNumber          String?
  joinDate            DateTime
  contractType        ContractType   @default(UNLIMITED)
  status              EmployeeStatus @default(ACTIVE)
  terminationDate     DateTime?
  // WPS payout routing
  bankCode            String?
  iban                String?
  costCenterId        String?
  costCenter          CostCenter?    @relation(fields: [costCenterId], references: [id])
  annualLeaveDays     Decimal        @default(21) @db.Decimal(7, 2)
  leaveOpeningBalance Decimal        @default(0) @db.Decimal(7, 2)
  basicSalary         Decimal        @default(0) @db.Decimal(18, 4)
  housingAllowance    Decimal        @default(0) @db.Decimal(18, 4)
  transportAllowance  Decimal        @default(0) @db.Decimal(18, 4)
  otherAllowance      Decimal        @default(0) @db.Decimal(18, 4)
  gosiExempt          Boolean        @default(false)
  createdByUserId     String
  updatedByUserId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  loans                    EmployeeLoan[]
  payrollRunLines          PayrollRunLine[]
  finalSettlement          FinalSettlement?
  manpowerAssignments      ManpowerAssignment[]
  timesheetEntries         TimesheetEntry[]
  employeeTimesheetEntries EmployeeTimesheetEntry[]
  payments                 EmployeePayment[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("employees")
}

// Loans are created and disbursed atomically (JE Dr employee-loans control /
// Cr bank-or-cash), so loanNumber and the disbursement JE are always present.
model EmployeeLoan {
  id                         String       @id @default(uuid())
  companyId                  String
  company                    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                 String
  employee                   Employee     @relation(fields: [employeeId], references: [id])
  loanNumber                 String
  principal                  Decimal      @db.Decimal(18, 4)
  monthlyInstallment         Decimal      @db.Decimal(18, 4)
  balance                    Decimal      @db.Decimal(18, 4)
  status                     LoanStatus   @default(ACTIVE)
  disbursementJournalEntryId String       @unique
  disbursementJournalEntry   JournalEntry @relation("LoanDisbursementJournal", fields: [disbursementJournalEntryId], references: [id])
  disbursementAccountId      String
  disbursementAccount        Account      @relation(fields: [disbursementAccountId], references: [id])
  memo                       String?
  createdByUserId            String
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@unique([companyId, loanNumber])
  @@index([employeeId, status])
  @@map("employee_loans")
}

// One POSTED payroll run per fiscal period (partial unique index in SQL
// migration — reverse-then-rerun for corrections). runNumber is allocated
// at posting time so abandoned drafts never create numbering gaps.
model PayrollRun {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalPeriodId         String
  fiscalPeriod           FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  runNumber              String?
  status                 PayrollRunStatus @default(DRAFT)
  runDate                DateTime         @default(now())
  journalEntryId         String?          @unique
  journalEntry           JournalEntry?    @relation("PayrollJournal", fields: [journalEntryId], references: [id])
  reversalJournalEntryId String?          @unique
  reversalJournalEntry   JournalEntry?    @relation("PayrollReversalJournal", fields: [reversalJournalEntryId], references: [id])
  totalGross             Decimal          @default(0) @db.Decimal(18, 4)
  totalGosiEmployee      Decimal          @default(0) @db.Decimal(18, 4)
  totalGosiEmployer      Decimal          @default(0) @db.Decimal(18, 4)
  totalLoanDeductions    Decimal          @default(0) @db.Decimal(18, 4)
  totalNetPay            Decimal          @default(0) @db.Decimal(18, 4)
  totalEosbDelta         Decimal          @default(0) @db.Decimal(18, 4)
  totalLeaveDelta        Decimal          @default(0) @db.Decimal(18, 4)
  createdByUserId        String
  postedByUserId         String?
  postedAt               DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  lines PayrollRunLine[]

  @@unique([companyId, runNumber])
  @@index([companyId, fiscalPeriodId])
  @@map("payroll_runs")
}

// Everything needed to audit a payslip is snapshotted on the line — salary
// structure, GOSI base/shares, exception inputs, and computed results.
model PayrollRunLine {
  id                    String      @id @default(uuid())
  runId                 String
  run                   PayrollRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId             String
  employeeId            String
  employee              Employee    @relation(fields: [employeeId], references: [id])
  // Salary snapshot
  basicSalary           Decimal     @db.Decimal(18, 4)
  housingAllowance      Decimal     @db.Decimal(18, 4)
  transportAllowance    Decimal     @db.Decimal(18, 4)
  otherAllowance        Decimal     @db.Decimal(18, 4)
  gosiBase              Decimal     @db.Decimal(18, 4)
  gosiEmployee          Decimal     @db.Decimal(18, 4)
  gosiEmployer          Decimal     @db.Decimal(18, 4)
  // Exception inputs (editable while the run is DRAFT)
  unpaidDays            Decimal     @default(0) @db.Decimal(7, 2)
  absentDays            Decimal     @default(0) @db.Decimal(7, 2)
  overtimeHours         Decimal     @default(0) @db.Decimal(7, 2)
  annualLeaveDaysTaken  Decimal     @default(0) @db.Decimal(7, 2)
  otherDeduction        Decimal     @default(0) @db.Decimal(18, 4)
  otherDeductionMemo    String?
  // Computed results
  overtimePay           Decimal     @default(0) @db.Decimal(18, 4)
  absenceDeduction      Decimal     @default(0) @db.Decimal(18, 4)
  loanDeduction         Decimal     @default(0) @db.Decimal(18, 4)
  // [{loanId, amount}] — lets a reversal restore each loan balance exactly.
  loanBreakdown         Json?
  grossPay              Decimal     @default(0) @db.Decimal(18, 4)
  netPay                Decimal     @default(0) @db.Decimal(18, 4)
  eosbEntitlementToDate Decimal     @default(0) @db.Decimal(18, 4)
  eosbDelta             Decimal     @default(0) @db.Decimal(18, 4)
  leaveBalanceDays      Decimal     @default(0) @db.Decimal(7, 2)
  leaveProvisionToDate  Decimal     @default(0) @db.Decimal(18, 4)
  leaveDelta            Decimal     @default(0) @db.Decimal(18, 4)
  costCenterId          String?
  costCenter            CostCenter? @relation(fields: [costCenterId], references: [id])

  @@unique([runId, employeeId])
  @@index([companyId, employeeId])
  @@map("payroll_run_lines")
}

model FinalSettlement {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId             String           @unique
  employee               Employee         @relation(fields: [employeeId], references: [id])
  settlementNumber       String
  reason                 SettlementReason
  lastWorkingDay         DateTime
  serviceYears           Decimal          @db.Decimal(7, 4)
  finalSalaryAmount      Decimal          @db.Decimal(18, 4)
  eosbAmount             Decimal          @db.Decimal(18, 4)
  leavePayoutAmount      Decimal          @db.Decimal(18, 4)
  loanRecovery           Decimal          @db.Decimal(18, 4)
  netAmount              Decimal          @db.Decimal(18, 4)
  // Provision balances cleared by the settlement JE (audit snapshot)
  eosbProvisionCleared   Decimal          @db.Decimal(18, 4)
  leaveProvisionCleared  Decimal          @db.Decimal(18, 4)
  // Cumulative amount actually paid out against this settlement; the
  // remaining pending balance is always netAmount − paidAmount.
  paidAmount             Decimal          @default(0) @db.Decimal(18, 4)
  journalEntryId         String           @unique
  journalEntry           JournalEntry     @relation("SettlementJournal", fields: [journalEntryId], references: [id])
  reversalJournalEntryId String?          @unique
  reversalJournalEntry   JournalEntry?    @relation("SettlementReversalJournal", fields: [reversalJournalEntryId], references: [id])
  status                 SettlementStatus @default(POSTED)
  createdByUserId        String
  createdAt              DateTime         @default(now())

  payments SettlementPayment[]

  @@unique([companyId, settlementNumber])
  @@map("final_settlements")
}

// One or more payouts recorded against a final settlement (a released
// employee is often paid over time rather than in one lump sum). Each
// payment posts its own JE (Dr Accrued Salaries Payable / Cr bank-cash).
model SettlementPayment {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  finalSettlementId String
  finalSettlement   FinalSettlement @relation(fields: [finalSettlementId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(18, 4)
  paymentDate       DateTime
  bankCashAccountId String
  bankCashAccount   Account         @relation(fields: [bankCashAccountId], references: [id])
  memo              String?
  journalEntryId    String          @unique
  journalEntry      JournalEntry    @relation("SettlementPaymentJournal", fields: [journalEntryId], references: [id])
  createdByUserId   String
  createdAt         DateTime        @default(now())

  @@index([finalSettlementId])
  @@map("settlement_payments")
}

// Day-by-day internal labor timesheet used for the per-project day-cost
// Overview — one entry per employee per calendar day (dayType + hours
// worked; hoursWorked always defaults to 0 and is entered explicitly,
// never assumed). Payroll-independent: distinct
// from HrSettings.daysPerMonth, which drives statutory payroll math, and
// from the manpower Timesheet/TimesheetEntry models, which are client-
// billing documents tied to a ManpowerContract and customer invoice.
model EmployeeTimesheetEntry {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  // Cascade: disposable costing metadata, not a financial record — it must
  // never block deleting a mistaken employee entry.
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  dayType         TimesheetDayType @default(WORKED)
  hoursWorked     Decimal          @default(0) @db.Decimal(5, 2)
  enteredByUserId String
  updatedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  attachment EmployeeTimesheetEntryAttachment?

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@map("employee_timesheet_entries")
}

// A single evidence file (site photo, delivery note, etc.) attached to one
// day's timesheet entry — same storage pattern as EmployeePaymentAttachment.
model EmployeeTimesheetEntryAttachment {
  id                       String                 @id @default(uuid())
  companyId                String
  company                  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeTimesheetEntryId String                 @unique
  employeeTimesheetEntry   EmployeeTimesheetEntry @relation(fields: [employeeTimesheetEntryId], references: [id], onDelete: Cascade)
  filename                 String
  mimeType                 String
  size                     Int
  data                     Bytes
  uploadedByUserId         String
  createdAt                DateTime               @default(now())

  @@map("employee_timesheet_entry_attachments")
}

// One-off cash paid to an employee outside formal payroll. ALLOWANCE is a
// straight expense (recoveredAmount always 0, service-enforced); ADVANCE/
// OTHER post to the same EMPLOYEE_LOANS control account as EmployeeLoan and
// remain pending (amount − recoveredAmount) until recovered.
model EmployeePayment {
  id                String                  @id @default(uuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee                @relation(fields: [employeeId], references: [id])
  paymentNumber     String?
  category          EmployeePaymentCategory
  amount            Decimal                 @db.Decimal(18, 4)
  paymentDate       DateTime
  bankCashAccountId String
  bankCashAccount   Account                 @relation("EmployeePaymentBankCash", fields: [bankCashAccountId], references: [id])
  // The expense account this payment's debit leg actually hit — set for
  // ALLOWANCE payments (either the user's chosen override or the resolved
  // ALLOWANCE_EXPENSE control account). Null on ADVANCE/OTHER payments
  // (those debit EMPLOYEE_LOANS, not an expense) and on rows created before
  // this field existed.
  expenseAccountId String?
  expenseAccount    Account?                @relation("EmployeePaymentExpenseAccount", fields: [expenseAccountId], references: [id])
  memo              String?
  recoveredAmount   Decimal                 @default(0) @db.Decimal(18, 4)
  journalEntryId    String                  @unique
  journalEntry      JournalEntry            @relation("EmployeePaymentJournal", fields: [journalEntryId], references: [id])
  createdByUserId   String
  createdAt         DateTime                @default(now())
  // Set once this payment is reversed (a wrong entry corrected via a
  // reversing JE rather than a hard delete). Reversed payments are excluded
  // from all paid/pending aggregations but kept for the audit trail.
  reversedAt DateTime?

  recoveries EmployeePaymentRecovery[]
  attachment EmployeePaymentAttachment?

  @@unique([companyId, paymentNumber])
  @@index([employeeId, category])
  @@map("employee_payments")
}

// A single receipt/evidence file attached to a payment — stored as bytes in
// the database (no separate file-storage infra exists yet, and this keeps
// receipts safely inside the same backed-up Postgres data, immune to
// deploy-time git operations on the app checkout). Uploading again replaces
// the existing attachment rather than accumulating duplicates.
model EmployeePaymentAttachment {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeePaymentId String          @unique
  employeePayment   EmployeePayment @relation(fields: [employeePaymentId], references: [id], onDelete: Cascade)
  filename          String
  mimeType          String
  size              Int
  data              Bytes
  uploadedByUserId  String
  createdAt         DateTime        @default(now())

  @@map("employee_payment_attachments")
}

// One or more recoveries recorded against an ADVANCE/OTHER EmployeePayment
// (mirrors SettlementPayment's partial-recovery pattern). Each recovery
// posts its own JE (Dr bank-cash / Cr EMPLOYEE_LOANS).
model EmployeePaymentRecovery {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeePaymentId String
  employeePayment   EmployeePayment @relation(fields: [employeePaymentId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(18, 4)
  recoveryDate      DateTime
  bankCashAccountId String
  bankCashAccount   Account         @relation(fields: [bankCashAccountId], references: [id])
  memo              String?
  journalEntryId    String          @unique
  journalEntry      JournalEntry    @relation("EmployeePaymentRecoveryJournal", fields: [journalEntryId], references: [id])
  createdByUserId   String
  createdAt         DateTime        @default(now())

  @@index([employeePaymentId])
  @@map("employee_payment_recoveries")
}

// ─────────────────────────────────────────────────────────────────────────
// Manpower Rental
// ─────────────────────────────────────────────────────────────────────────

// Rental contract hiring out employees to a client site. Auto-creates its
// 1:1 cost center MPR-<code> so billing revenue and the assigned crew's
// payroll cost meet on one dimension (same pattern as Project).
model ManpowerContract {
  id                String                 @id @default(uuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code              String
  name              String
  businessPartnerId String
  businessPartner   BusinessPartner        @relation(fields: [businessPartnerId], references: [id])
  status            ManpowerContractStatus @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  costCenterId      String                 @unique
  costCenter        CostCenter             @relation(fields: [costCenterId], references: [id])
  memo              String?
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  assignments ManpowerAssignment[]
  timesheets  Timesheet[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("manpower_contracts")
}

model ManpowerAssignment {
  id              String           @id @default(uuid())
  contractId      String
  contract        ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  companyId       String
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  rateBasis       RateBasis
  billRate        Decimal          @db.Decimal(18, 4)
  // 0 = overtime is not billable on this assignment
  otBillRate      Decimal          @default(0) @db.Decimal(18, 4)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean          @default(true)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  timesheetEntries TimesheetEntry[]

  @@index([contractId])
  @@index([employeeId, isActive])
  @@map("manpower_assignments")
}

// One timesheet per contract per fiscal period. DRAFT entries are editable;
// APPROVED locks them for billing; INVOICED links the generated AR draft.
model Timesheet {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId       String
  contract         ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fiscalPeriodId   String
  fiscalPeriod     FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  status           TimesheetStatus  @default(DRAFT)
  salesInvoiceId   String?          @unique
  salesInvoice     SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  approvedByUserId String?
  approvedAt       DateTime?
  createdByUserId  String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  entries TimesheetEntry[]

  @@unique([contractId, fiscalPeriodId])
  @@index([companyId, status])
  @@map("timesheets")
}

model TimesheetEntry {
  id            String             @id @default(uuid())
  timesheetId   String
  timesheet     Timesheet          @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  companyId     String
  assignmentId  String
  assignment    ManpowerAssignment @relation(fields: [assignmentId], references: [id])
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  date          DateTime
  dayType       TimesheetDayType   @default(WORKED)
  // Hours worked that day — drives HOURLY-basis billing
  hours         Decimal            @default(0) @db.Decimal(7, 2)
  overtimeHours Decimal            @default(0) @db.Decimal(7, 2)

  @@unique([timesheetId, assignmentId, date])
  @@index([employeeId, date])
  @@map("timesheet_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Equipment Rental & Fixed-Asset Ledger
// ─────────────────────────────────────────────────────────────────────────

// A rentable fixed-asset unit. Straight-line depreciation:
// monthly = (cost − salvage) / usefulLifeMonths; accumulated (opening +
// posted run lines) never exceeds cost − salvage.
model Equipment {
  id                             String          @id @default(uuid())
  companyId                      String
  company                        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                           String
  name                           String
  category                       String?
  serialNumber                   String?
  status                         EquipmentStatus @default(ACTIVE)
  acquisitionDate                DateTime
  acquisitionCost                Decimal         @db.Decimal(18, 4)
  salvageValue                   Decimal         @default(0) @db.Decimal(18, 4)
  usefulLifeMonths               Int
  depreciationStartDate          DateTime
  // For assets bought used / migrated with existing depreciation
  openingAccumulatedDepreciation Decimal         @default(0) @db.Decimal(18, 4)
  capitalizationJournalEntryId   String?         @unique
  capitalizationJournalEntry     JournalEntry?   @relation("EquipmentCapitalizationJournal", fields: [capitalizationJournalEntryId], references: [id])
  disposalDate                   DateTime?
  disposalProceeds               Decimal?        @db.Decimal(18, 4)
  disposalJournalEntryId         String?         @unique
  disposalJournalEntry           JournalEntry?   @relation("EquipmentDisposalJournal", fields: [disposalJournalEntryId], references: [id])
  createdByUserId                String
  updatedByUserId                String?
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  assignments          EquipmentAssignment[]
  usageLogEntries      UsageLogEntry[]
  depreciationRunLines DepreciationRunLine[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("equipment")
}

model EquipmentRentalContract {
  id                String                 @id @default(uuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code              String
  name              String
  businessPartnerId String
  businessPartner   BusinessPartner        @relation(fields: [businessPartnerId], references: [id])
  status            ManpowerContractStatus @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  costCenterId      String                 @unique
  costCenter        CostCenter             @relation(fields: [costCenterId], references: [id])
  memo              String?
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  assignments EquipmentAssignment[]
  usageLogs   UsageLog[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("equipment_rental_contracts")
}

model EquipmentAssignment {
  id              String                  @id @default(uuid())
  contractId      String
  contract        EquipmentRentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  companyId       String
  equipmentId     String
  equipment       Equipment               @relation(fields: [equipmentId], references: [id])
  rateBasis       RateBasis
  billRate        Decimal                 @db.Decimal(18, 4)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean                 @default(true)
  createdByUserId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  usageLogEntries UsageLogEntry[]

  @@index([contractId])
  @@index([equipmentId, isActive])
  @@map("equipment_assignments")
}

// One usage log per contract per fiscal period (mirror of Timesheet).
model UsageLog {
  id               String                  @id @default(uuid())
  companyId        String
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId       String
  contract         EquipmentRentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fiscalPeriodId   String
  fiscalPeriod     FiscalPeriod            @relation(fields: [fiscalPeriodId], references: [id])
  status           TimesheetStatus         @default(DRAFT)
  salesInvoiceId   String?                 @unique
  salesInvoice     SalesInvoice?           @relation(fields: [salesInvoiceId], references: [id])
  approvedByUserId String?
  approvedAt       DateTime?
  createdByUserId  String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  entries UsageLogEntry[]

  @@unique([contractId, fiscalPeriodId])
  @@index([companyId, status])
  @@map("usage_logs")
}

model UsageLogEntry {
  id           String              @id @default(uuid())
  usageLogId   String
  usageLog     UsageLog            @relation(fields: [usageLogId], references: [id], onDelete: Cascade)
  companyId    String
  assignmentId String
  assignment   EquipmentAssignment @relation(fields: [assignmentId], references: [id])
  equipmentId  String
  equipment    Equipment           @relation(fields: [equipmentId], references: [id])
  date         DateTime
  dayStatus    UsageDayType        @default(ON_RENT)
  // Metered hours that day — drives HOURLY-basis billing
  hoursUsed    Decimal             @default(0) @db.Decimal(7, 2)

  @@unique([usageLogId, assignmentId, date])
  @@index([equipmentId, date])
  @@map("usage_log_entries")
}

// One POSTED depreciation run per fiscal period (partial unique in SQL
// migration — reverse-then-rerun). Posts immediately: create = post.
model DepreciationRun {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalPeriodId         String
  fiscalPeriod           FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  runNumber              String
  status                 PayrollRunStatus @default(POSTED)
  journalEntryId         String           @unique
  journalEntry           JournalEntry     @relation("DepreciationJournal", fields: [journalEntryId], references: [id])
  reversalJournalEntryId String?          @unique
  reversalJournalEntry   JournalEntry?    @relation("DepreciationReversalJournal", fields: [reversalJournalEntryId], references: [id])
  totalAmount            Decimal          @db.Decimal(18, 4)
  createdByUserId        String
  createdAt              DateTime         @default(now())

  lines DepreciationRunLine[]

  @@unique([companyId, runNumber])
  @@index([companyId, fiscalPeriodId])
  @@map("depreciation_runs")
}

model DepreciationRunLine {
  id               String          @id @default(uuid())
  runId            String
  run              DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId        String
  equipmentId      String
  equipment        Equipment       @relation(fields: [equipmentId], references: [id])
  amount           Decimal         @db.Decimal(18, 4)
  accumulatedAfter Decimal         @db.Decimal(18, 4)
  nbvAfter         Decimal         @db.Decimal(18, 4)
  // Rental contract's CC when the unit was assigned at period end
  costCenterId     String?
  costCenter       CostCenter?     @relation(fields: [costCenterId], references: [id])

  @@unique([runId, equipmentId])
  @@map("depreciation_run_lines")
}
