generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum AccountClassCode {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// IFRS 18 Presentation and Disclosure in Financial Statements — the three
// new mandatory income-statement categories, plus income tax (already a
// distinct line, now formally categorized too). Only meaningful on
// REVENUE/EXPENSE sub-classes; ASSET/LIABILITY/EQUITY sub-classes leave
// this null since the Statement of Financial Position doesn't use it —
// only AccountSubClass.isCurrent does, unchanged. Discontinued operations
// is deliberately not modeled: nothing in this business's data would ever
// exercise it.
enum Ifrs18Category {
  OPERATING
  INVESTING
  FINANCING
  INCOME_TAX
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// Which of the three Project Intelligence dashboard buckets an expense
// account rolls up into. Null means "uncategorized" — shown as Other so
// nothing is silently dropped from the dashboard's totals.
enum ProjectCostCategory {
  MATERIAL
  MACHINERY
  LABOR
}

enum ControlAccountType {
  AR
  AP
  INVENTORY
  BANK
  CASH
  VAT_OUTPUT
  VAT_INPUT
  COGS
  INVENTORY_ADJUSTMENT
  CONTRACT_ASSET
  CONTRACT_LIABILITY
  CONTRACT_REVENUE
  EMPLOYEE_LOANS
  SALARIES_PAYABLE
  GOSI_PAYABLE
  EOSB_PROVISION
  LEAVE_PROVISION
  SALARY_EXPENSE
  PROJECT_SALARY_EXPENSE
  GOSI_EXPENSE
  EOSB_EXPENSE
  LEAVE_EXPENSE
  MANPOWER_REVENUE
  EQUIPMENT_REVENUE
  DISPOSAL_GAIN_LOSS
  EQUIPMENT_ASSET
  ACCUM_DEPRECIATION
  DEPRECIATION_EXPENSE
  ALLOWANCE_EXPENSE
  FOOD_EXPENSE
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum FiscalPeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSourceModule {
  MANUAL
  AR
  AP
  INVENTORY
  PAYROLL
  PROJECTS
  EQUIPMENT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CLOSED
}

enum RecognitionMethod {
  POINT_IN_TIME
  OVER_TIME
}

enum RevenueRecognitionRunStatus {
  POSTED
  REVERSED
}

enum DocumentType {
  JOURNAL_ENTRY
  SALES_INVOICE
  CREDIT_NOTE
  PURCHASE_INVOICE
  PURCHASE_QUOTATION
  PURCHASE_ORDER
  GOODS_RECEIPT
  GOODS_ISSUE
  INCOMING_PAYMENT
  OUTGOING_PAYMENT
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  PAYROLL_RUN
  EMPLOYEE_LOAN
  FINAL_SETTLEMENT
  DEPRECIATION_RUN
  EMPLOYEE_PAYMENT
}

enum EquipmentStatus {
  ACTIVE
  DISPOSED
}

// Billable = anything except BREAKDOWN (idle units kept on site still bill).
enum UsageDayType {
  ON_RENT
  IDLE
  BREAKDOWN
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

enum ContractType {
  UNLIMITED
  LIMITED
}

enum PayrollRunStatus {
  DRAFT
  POSTED
  REVERSED
}

enum LoanStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

// Wage basis for EOSB and leave provisions. Saudi Labor Law "wage" is the
// full last wage; some firms provision on basic+housing only.
enum EosbBasis {
  BASIC_ONLY
  BASIC_HOUSING
  FULL_GROSS
}

enum SettlementReason {
  RESIGNATION
  TERMINATION_BY_EMPLOYER
  CONTRACT_END
}

enum SettlementStatus {
  POSTED
  REVERSED
}

enum ManpowerContractStatus {
  ACTIVE
  CLOSED
}

enum RateBasis {
  HOURLY
  DAILY
  MONTHLY
}

enum TimesheetStatus {
  DRAFT
  APPROVED
  INVOICED
}

enum TimesheetDayType {
  WORKED
  REST
  ABSENT
  UNPAID_LEAVE
  ANNUAL_LEAVE
}

// Informal, manually-settled cash paid to an employee outside payroll —
// distinct from EmployeeLoan (formal, installment-scheduled advances).
// ALLOWANCE, FOOD and SALARY are straight expenses (nothing pending); FOOD
// is tracked separately from ALLOWANCE for reporting only — both default to
// the same ALLOWANCE_EXPENSE control account. SALARY specifically pays down
// the timesheet-accrued "pending salary" figure (reducing it the same way a
// posted PayrollRun's net pay does), routed to SALARY_EXPENSE/
// PROJECT_SALARY_EXPENSE like payroll. ADVANCE/OTHER post to the same
// employee-loans control account as Loans and stay pending until recovered.
enum EmployeePaymentCategory {
  ALLOWANCE
  ADVANCE
  OTHER
  SALARY
  FOOD
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum StockAdjustmentDirection {
  IN
  OUT
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SalesDocumentKind {
  INVOICE
  CREDIT_NOTE
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentStatus {
  POSTED
  CANCELLED
}

enum ZatcaEnvironment {
  SANDBOX
  SIMULATION
  PRODUCTION
}

enum ZatcaDeviceStatus {
  CREATED
  COMPLIANCE_CSID_ISSUED
  COMPLIANCE_CHECKED
  ACTIVE
  FAILED
  REVOKED
}

enum ZatcaInvoiceKind {
  STANDARD
  SIMPLIFIED
}

enum ZatcaSubmissionType {
  CLEARANCE
  REPORTING
}

enum ZatcaSubmissionStatus {
  PENDING
  CLEARED
  REPORTED
  REJECTED
  FAILED
}

enum PartnerType {
  CUSTOMER
  VENDOR
  BOTH
}

enum PartnerAddressType {
  BILLING
  SHIPPING
  LEGAL
}

enum ItemType {
  INVENTORY
  SERVICE
  NON_INVENTORY
}

enum VatCategory {
  STANDARD_15
  ZERO_RATED
  EXEMPT
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  REVERSE
  CLOSE
}

// ─────────────────────────────────────────────────────────────────────────
// IAM: users, companies, membership, roles, permissions
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  /// Cross-tenant SaaS-provider view (see PlatformModule) — not a company
  /// permission, this bypasses tenant scoping entirely.
  isPlatformAdmin Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyMemberships CompanyUser[]
  refreshTokens      RefreshToken[]
  joinRequests       CompanyJoinRequest[]

  @@map("users")
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String
  activeCompanyId String?
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Company {
  id                    String   @id @default(uuid())
  code                  String   @unique
  legalName             String
  tradeName             String?
  countryCode           String
  baseCurrencyCode      String
  taxRegistrationNumber String?
  crNumber              String?
  addressLine1          String?
  addressLine2          String?
  // ZATCA UBL seller address requires structured components (BR-KSA rules)
  buildingNumber        String?
  district              String?
  additionalNumber      String?
  city                  String?
  postalCode            String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  companyUsers              CompanyUser[]
  roles                     Role[]
  fiscalYears               FiscalYear[]
  accounts                  Account[]
  costCenters               CostCenter[]
  journalEntries            JournalEntry[]
  businessPartners          BusinessPartner[]
  items                     Item[]
  warehouses                Warehouse[]
  numberingSeries           NumberingSeries[]
  auditLogs                 AuditLog[]
  exchangeRates             ExchangeRate[]
  salesInvoices             SalesInvoice[]
  purchaseInvoices          PurchaseInvoice[]
  purchaseQuotations        PurchaseQuotation[]
  purchaseOrders            PurchaseOrder[]
  payments                  Payment[]
  zatcaDevices              ZatcaDevice[]
  projects                  Project[]
  hrSettings                HrSettings?
  employees                 Employee[]
  employeeLoans             EmployeeLoan[]
  payrollRuns               PayrollRun[]
  finalSettlements          FinalSettlement[]
  manpowerContracts         ManpowerContract[]
  timesheets                Timesheet[]
  equipment                 Equipment[]
  equipmentRentalContracts  EquipmentRentalContract[]
  usageLogs                 UsageLog[]
  depreciationRuns          DepreciationRun[]
  settlementPayments        SettlementPayment[]
  employeeTimesheetEntries  EmployeeTimesheetEntry[]
  employeePayments          EmployeePayment[]
  employeePaymentRecoveries EmployeePaymentRecovery[]
  employeePaymentAttachments EmployeePaymentAttachment[]
  purchaseInvoiceLineAttachments PurchaseInvoiceLineAttachment[]
  employeeTimesheetEntryAttachments EmployeeTimesheetEntryAttachment[]
  joinRequests              CompanyJoinRequest[]

  @@map("companies")
}

model CompanyUser {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role              @relation(fields: [roleId], references: [id])
  status    CompanyUserStatus @default(ACTIVE)
  isDefault Boolean           @default(false)
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

model Role {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  companyUsers    CompanyUser[]
  joinRequests    CompanyJoinRequest[]

  @@unique([companyId, name])
  @@map("roles")
}

enum CompanyJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A user's self-service request to join an existing company by its code.
// Deliberately a separate model rather than reusing CompanyUser with a new
// status: CompanyUser.roleId is non-nullable and @@unique([userId,
// companyId]) would collide between "was rejected once" and "wants to
// request again". No DB-level uniqueness here on purpose — a rejected
// request must be re-requestable; the service layer blocks duplicates by
// checking for an existing PENDING row instead.
model CompanyJoinRequest {
  id              String                   @id @default(uuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          CompanyJoinRequestStatus @default(PENDING)
  message         String?
  requestedAt     DateTime                 @default(now())
  decidedByUserId String?
  decidedAt       DateTime?
  roleId          String?
  role            Role?                    @relation(fields: [roleId], references: [id])

  @@index([companyId, status])
  @@index([userId])
  @@map("company_join_requests")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
// Fiscal calendar
// ─────────────────────────────────────────────────────────────────────────

model FiscalYear {
  id             String           @id @default(uuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String
  startDate      DateTime
  endDate        DateTime
  status         FiscalYearStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  periods         FiscalPeriod[]
  journalEntries  JournalEntry[]
  numberingSeries NumberingSeries[]

  @@unique([companyId, code])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id           String             @id @default(uuid())
  fiscalYearId String
  fiscalYear   FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  companyId    String
  periodNumber Int
  startDate    DateTime
  endDate      DateTime
  status       FiscalPeriodStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  journalEntries         JournalEntry[]
  revenueRecognitionRuns RevenueRecognitionRun[]
  payrollRuns            PayrollRun[]
  timesheets             Timesheet[]
  usageLogs              UsageLog[]
  depreciationRuns       DepreciationRun[]

  @@unique([fiscalYearId, periodNumber])
  @@index([companyId])
  @@map("fiscal_periods")
}

// ─────────────────────────────────────────────────────────────────────────
// Currency
// ─────────────────────────────────────────────────────────────────────────

model Currency {
  code          String @id
  name          String
  decimalPlaces Int    @default(2)

  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromCurrencyCode String
  fromCurrency     Currency @relation("FromCurrency", fields: [fromCurrencyCode], references: [code])
  toCurrencyCode   String
  toCurrency       Currency @relation("ToCurrency", fields: [toCurrencyCode], references: [code])
  rateDate         DateTime
  rate             Decimal  @db.Decimal(18, 8)
  createdAt        DateTime @default(now())

  @@unique([companyId, fromCurrencyCode, toCurrencyCode, rateDate])
  @@map("exchange_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// Chart of Accounts
// ─────────────────────────────────────────────────────────────────────────

model AccountClass {
  id   String           @id @default(uuid())
  code AccountClassCode @unique
  name String

  subClasses AccountSubClass[]
  accounts   Account[]

  @@map("account_classes")
}

model AccountSubClass {
  id             String          @id @default(uuid())
  accountClassId String
  accountClass   AccountClass    @relation(fields: [accountClassId], references: [id])
  code           String          @unique
  name           String
  isCurrent      Boolean? // relevant for Asset/Liability current vs non-current classification
  ifrs18Category Ifrs18Category? // relevant for Revenue/Expense P&L categorization (IFRS 18)
  sortOrder      Int             @default(0)

  accounts Account[]

  @@map("account_sub_classes")
}

model Account {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  nameAr             String?
  accountClassId     String
  accountClass       AccountClass        @relation(fields: [accountClassId], references: [id])
  accountSubClassId  String
  accountSubClass    AccountSubClass     @relation(fields: [accountSubClassId], references: [id])
  parentAccountId    String?
  parentAccount      Account?            @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts      Account[]           @relation("AccountHierarchy")
  isPostable         Boolean             @default(true)
  normalBalance      NormalBalance
  currencyCode       String?
  controlAccountType ControlAccountType?
  // Project Intelligence dashboard bucket (Material/Machinery/Labor). Set
  // via the same PATCH /coa/accounts/:id used for renaming — nullable and
  // user-correctable, not a fixed mapping.
  costCategory       ProjectCostCategory?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  journalEntryLines           JournalEntryLine[]
  salesInvoiceLines           SalesInvoiceLine[]
  purchaseInvoiceLines        PurchaseInvoiceLine[]
  payments                    Payment[]
  employeeLoanDisbursements   EmployeeLoan[]
  settlementPayments          SettlementPayment[]
  employeePayments            EmployeePayment[]                @relation("EmployeePaymentBankCash")
  employeePaymentExpenseFor   EmployeePayment[]                @relation("EmployeePaymentExpenseAccount")
  employeePaymentRecoveries   EmployeePaymentRecovery[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("accounts")
}

// Stub for the future Projects module — exists now only so JournalEntryLine
// can carry a cost-center dimension from day one without a later migration.
model CostCenter {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  // Set when this cost center is the auto-created 1:1 partner of a project.
  project   Project?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  journalEntryLines       JournalEntryLine[]
  employees               Employee[]
  payrollRunLines         PayrollRunLine[]
  salesInvoiceLines       SalesInvoiceLine[]
  manpowerContract        ManpowerContract?
  purchaseInvoiceLines    PurchaseInvoiceLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  equipmentRentalContract EquipmentRentalContract?
  depreciationRunLines    DepreciationRunLine[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

// ─────────────────────────────────────────────────────────────────────────
// General Ledger
// ─────────────────────────────────────────────────────────────────────────

model JournalEntry {
  id                       String              @id @default(uuid())
  companyId                String
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Null while Draft — numbers are allocated only at posting time (via
  // NumberingService, under a row lock) so an abandoned/deleted draft never
  // creates a gap in the posted sequence.
  entryNumber              String?
  fiscalYearId             String
  fiscalYear               FiscalYear          @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriodId           String
  fiscalPeriod             FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
  postingDate              DateTime
  documentDate             DateTime
  currencyCode             String
  exchangeRateToFunctional Decimal             @default(1) @db.Decimal(18, 8)
  status                   JournalEntryStatus  @default(DRAFT)
  sourceModule             JournalSourceModule @default(MANUAL)
  sourceDocumentId         String?
  reversalOfEntryId        String?             @unique
  reversalOfEntry          JournalEntry?       @relation("JournalReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry          JournalEntry?       @relation("JournalReversal")
  memo                     String?
  createdByUserId          String
  updatedByUserId          String?
  postedByUserId           String?
  postedAt                 DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  lines JournalEntryLine[]

  salesInvoice            SalesInvoice?
  purchaseInvoice         PurchaseInvoice?
  payment                 Payment?
  stockMovements          StockMovement[]
  stockAdjustment         StockAdjustment?
  revRecRun               RevenueRecognitionRun?   @relation("RevRecJournal")
  revRecReversalRun       RevenueRecognitionRun?   @relation("RevRecReversalJournal")
  loanDisbursement        EmployeeLoan?            @relation("LoanDisbursementJournal")
  payrollRun              PayrollRun?              @relation("PayrollJournal")
  payrollReversalRun      PayrollRun?              @relation("PayrollReversalJournal")
  finalSettlement         FinalSettlement?         @relation("SettlementJournal")
  finalSettlementReversal FinalSettlement?         @relation("SettlementReversalJournal")
  equipmentCapitalization Equipment?               @relation("EquipmentCapitalizationJournal")
  equipmentDisposal       Equipment?               @relation("EquipmentDisposalJournal")
  depreciationRun         DepreciationRun?         @relation("DepreciationJournal")
  depreciationReversalRun DepreciationRun?         @relation("DepreciationReversalJournal")
  settlementPayment       SettlementPayment?       @relation("SettlementPaymentJournal")
  employeePayment         EmployeePayment?         @relation("EmployeePaymentJournal")
  employeePaymentRecovery EmployeePaymentRecovery? @relation("EmployeePaymentRecoveryJournal")

  @@unique([companyId, entryNumber])
  @@index([companyId, status])
  @@index([companyId, fiscalPeriodId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                          String           @id @default(uuid())
  journalEntryId              String
  journalEntry                JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  companyId                   String
  lineNumber                  Int
  accountId                   String
  account                     Account          @relation(fields: [accountId], references: [id])
  debit                       Decimal          @default(0) @db.Decimal(18, 4)
  credit                      Decimal          @default(0) @db.Decimal(18, 4)
  description                 String?
  businessPartnerId           String?
  businessPartner             BusinessPartner? @relation(fields: [businessPartnerId], references: [id])
  costCenterId                String?
  costCenter                  CostCenter?      @relation(fields: [costCenterId], references: [id])
  wbsTaskId                   String?
  wbsTask                     WbsTask?         @relation(fields: [wbsTaskId], references: [id])
  currencyCode                String
  amountInTransactionCurrency Decimal          @db.Decimal(18, 4)
  amountInFunctionalCurrency  Decimal          @db.Decimal(18, 4)

  @@index([companyId, accountId])
  @@index([costCenterId])
  @@index([journalEntryId])
  @@map("journal_entry_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Master data: Business Partners
// ─────────────────────────────────────────────────────────────────────────

model BusinessPartner {
  id                           String      @id @default(uuid())
  companyId                    String
  company                      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                         String
  name                         String
  nameAr                       String?
  partnerType                  PartnerType
  taxRegistrationNumber        String?
  commercialRegistrationNumber String?
  // Buyer other-ID for ZATCA standard invoices when the buyer has no VAT
  // registration (schemeID: CRN|MOM|MLS|700|SAG|NAT|GCC|IQA|OTH)
  additionalIdScheme           String?
  additionalIdNumber           String?
  currencyCode                 String?
  isActive                     Boolean     @default(true)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  addresses                PartnerAddress[]
  journalEntryLines        JournalEntryLine[]
  salesInvoices            SalesInvoice[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseQuotations       PurchaseQuotation[]
  purchaseOrders           PurchaseOrder[]
  payments                 Payment[]
  projects                 Project[]
  manpowerContracts        ManpowerContract[]
  equipmentRentalContracts EquipmentRentalContract[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("business_partners")
}

model PartnerAddress {
  id                String             @id @default(uuid())
  businessPartnerId String
  businessPartner   BusinessPartner    @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  addressType       PartnerAddressType
  street            String?
  buildingNumber    String?
  district          String?
  city              String?
  postalCode        String?
  countryCode       String?

  @@map("partner_addresses")
}

// ─────────────────────────────────────────────────────────────────────────
// Master data: Items, UoM, Warehouse
// ─────────────────────────────────────────────────────────────────────────

model UnitOfMeasure {
  id         String  @id @default(uuid())
  companyId  String?
  code       String
  name       String
  isBaseUnit Boolean @default(true)

  itemsAsBase          Item[]                @relation("BaseUoM")
  itemsAsSales         Item[]                @relation("SalesUoM")
  itemsAsPurchase      Item[]                @relation("PurchaseUoM")
  conversionsFrom      UoMConversion[]       @relation("FromUoM")
  conversionsTo        UoMConversion[]       @relation("ToUoM")
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@unique([companyId, code])
  @@map("units_of_measure")
}

model UoMConversion {
  id        String        @id @default(uuid())
  fromUoMId String
  fromUoM   UnitOfMeasure @relation("FromUoM", fields: [fromUoMId], references: [id])
  toUoMId   String
  toUoM     UnitOfMeasure @relation("ToUoM", fields: [toUoMId], references: [id])
  factor    Decimal       @db.Decimal(18, 6)

  @@unique([fromUoMId, toUoMId])
  @@map("uom_conversions")
}

model Item {
  id                        String         @id @default(uuid())
  companyId                 String
  company                   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                      String
  name                      String
  nameAr                    String?
  itemType                  ItemType
  baseUoMId                 String
  baseUoM                   UnitOfMeasure  @relation("BaseUoM", fields: [baseUoMId], references: [id])
  salesUoMId                String?
  salesUoM                  UnitOfMeasure? @relation("SalesUoM", fields: [salesUoMId], references: [id])
  purchaseUoMId             String?
  purchaseUoM               UnitOfMeasure? @relation("PurchaseUoM", fields: [purchaseUoMId], references: [id])
  isSalesItem               Boolean        @default(true)
  isPurchaseItem            Boolean        @default(true)
  isInventoryItem           Boolean        @default(false)
  defaultSalesAccountId     String?
  defaultPurchaseAccountId  String?
  defaultInventoryAccountId String?
  vatCategory               VatCategory    @default(STANDARD_15)
  isActive                  Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  salesInvoiceLines      SalesInvoiceLine[]
  purchaseInvoiceLines   PurchaseInvoiceLine[]
  purchaseQuotationLines PurchaseQuotationLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  stockLevels            ItemWarehouseStock[]
  stockMovements         StockMovement[]
  stockTransferLines     StockTransferLine[]
  stockAdjustmentLines   StockAdjustmentLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("items")
}

model Warehouse {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  // Exactly one default per company (partial unique index in
  // inventory-constraints migration); preselected on invoice lines.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  stockLevels          ItemWarehouseStock[]
  stockMovements       StockMovement[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  transfersFrom        StockTransfer[]       @relation("TransferFrom")
  transfersTo          StockTransfer[]       @relation("TransferTo")
  adjustments          StockAdjustment[]

  @@unique([companyId, code])
  @@map("warehouses")
}

// ─────────────────────────────────────────────────────────────────────────
// Document numbering
// ─────────────────────────────────────────────────────────────────────────

model NumberingSeries {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType DocumentType
  prefix       String?
  nextNumber   Int          @default(1)
  numberLength Int          @default(6)
  fiscalYearId String?
  fiscalYear   FiscalYear?  @relation(fields: [fiscalYearId], references: [id])
  isActive     Boolean      @default(true)

  @@unique([companyId, documentType, fiscalYearId])
  @@map("numbering_series")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id              String      @id @default(uuid())
  companyId       String?
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  entityName      String
  entityId        String
  action          AuditAction
  changedByUserId String?
  changedAt       DateTime    @default(now())
  beforeSnapshot  Json?
  afterSnapshot   Json?
