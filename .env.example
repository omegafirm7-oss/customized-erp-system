# The options=-c%20TimeZone%3DUTC param forces the Postgres SESSION to run
# in UTC regardless of the server/OS locale. Required: raw report queries
# compare JS Date parameters (always UTC) against naive `timestamp` columns,
# and Postgres converts one side to the session timezone before comparing —
# without this, a non-UTC server locale silently shifts date-boundary
# comparisons by the server's UTC offset (e.g. a JE posted at exactly
# midnight UTC on a report's fromDate could be excluded from it).
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp?schema=public&options=-c%20TimeZone%3DUTC"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"
PORT=3000

# ZATCA e-invoicing: 32-byte key (base64 or 64-char hex) encrypting device
# private keys + CSID secrets at rest. Generate: openssl rand -base64 32
ZATCA_KEY_ENCRYPTION_KEY=""
# Fatoora API host (env path segment is appended per device environment)
ZATCA_HOST="https://gw-fatoora.zatca.gov.sa/e-invoicing"
ZATCA_TIMEOUT_MS=30000


# Outgoing mail (password-reset links + CRM outreach emails). Empty host =
# mail inert. Microsoft 365: smtp.office365.com / 587, SMTP_USER = the sending
# mailbox, and "Authenticated SMTP" must be enabled for that mailbox in the
# M365 admin center (it is off by default on many tenants).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# CRM sales agent (AI lead research + WhatsApp/email drafting). Leave the key
# empty to keep the AI buttons inert.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
